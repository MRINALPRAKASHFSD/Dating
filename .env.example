# Supabase Configuration
# Required: The URL and publishable (anon) key for your Supabase project
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-side Supabase environment variables (mirrors client variables for SSR)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"

# Optional: Server-side service role key (only required for privileged administrative/backend tasks)
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional: Cron authentication secrets
# CRON_SECRET="your-cron-secret"
# CRON_SECRET_PREVIOUS="your-previous-cron-secret"
